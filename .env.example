DATABASE_URL=postgresql+psycopg2://drivenow:drivenow@localhost:5432/drivenow
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=logs/drivenow.log
LOG_JSON=false

# Messaging (outbox relay)
EVENT_PUBLISHER=logging
RABBITMQ_URL=amqp://drivenow:drivenow@localhost:5672/
EVENTS_EXCHANGE=drivenow.events
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=5
